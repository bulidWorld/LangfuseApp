<?xml version='1.0' encoding='utf-8'?>
<database xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="langfuse" source="packages/shared/prisma/schema.prisma" dialect="postgresql" xsi:noNamespaceSchemaLocation="database.xsd">
  <tables>
    <table name="datasets">
      <columns>
        <column name="id" type="TEXT" nullable="false" />
        <column name="project_id" type="TEXT" nullable="false" ref-table="projects" ref-col="id" />
        <column name="name" type="TEXT" nullable="false" />
        <column name="description" type="TEXT" nullable="true" />
        <column name="metadata" type="JSONB" nullable="true" />
        <column name="remote_experiment_url" type="TEXT" nullable="true" />
        <column name="remote_experiment_payload" type="JSONB" nullable="true" />
        <column name="created_at" type="TIMESTAMP(3) NOT NULL" nullable="true" default="CURRENT_TIMESTAMP" />
        <column name="updated_at" type="TIMESTAMP(3) NOT NULL" nullable="true" default="CURRENT_TIMESTAMP" />
      </columns>
      <constraints>
        <primary-key name="datasets_pkey" columns="id, project_id" />
      </constraints>
      <indexes>
        <index name="datasets_created_at_idx" unique="false">
          <column name="created_at" />
        </index>
        <index name="datasets_updated_at_idx" unique="false">
          <column name="updated_at" />
        </index>
        <index name="datasets_project_id_name_key" unique="true">
          <column name="project_id" />
          <column name="name" />
        </index>
      </indexes>
    </table>
    <table name="dataset_items">
      <columns>
        <column name="id" type="TEXT" nullable="false" />
        <column name="project_id" type="TEXT" nullable="false" ref-table="datasets" ref-col="project_id" />
        <column name="status" type="&quot;DatasetStatus&quot; NOT NULL" nullable="true" default="'ACTIVE'" />
        <column name="input" type="JSONB" nullable="true" />
        <column name="expected_output" type="JSONB" nullable="true" />
        <column name="metadata" type="JSONB" nullable="true" />
        <column name="source_trace_id" type="TEXT" nullable="true" />
        <column name="source_observation_id" type="TEXT" nullable="true" />
        <column name="dataset_id" type="TEXT" nullable="false" ref-table="datasets" ref-col="id" />
        <column name="created_at" type="TIMESTAMP(3) NOT NULL" nullable="true" default="CURRENT_TIMESTAMP" />
        <column name="updated_at" type="TIMESTAMP(3) NOT NULL" nullable="true" default="CURRENT_TIMESTAMP" />
      </columns>
      <constraints>
        <primary-key name="dataset_items_pkey" columns="id, project_id" />
      </constraints>
      <indexes>
        <index name="dataset_items_source_trace_id_idx" unique="false" method="hash">
          <column name="source_trace_id" />
        </index>
        <index name="dataset_items_source_observation_id_idx" unique="false" method="hash">
          <column name="source_observation_id" />
        </index>
        <index name="dataset_items_dataset_id_idx" unique="false" method="hash">
          <column name="dataset_id" />
        </index>
        <index name="dataset_items_created_at_idx" unique="false">
          <column name="created_at" />
        </index>
        <index name="dataset_items_updated_at_idx" unique="false">
          <column name="updated_at" />
        </index>
      </indexes>
    </table>
    <table name="dataset_runs">
      <columns>
        <column name="id" type="TEXT" nullable="false" />
        <column name="project_id" type="TEXT" nullable="false" ref-table="datasets" ref-col="project_id" />
        <column name="name" type="TEXT" nullable="false" />
        <column name="description" type="TEXT" nullable="true" />
        <column name="metadata" type="JSONB" nullable="true" />
        <column name="dataset_id" type="TEXT" nullable="false" ref-table="datasets" ref-col="id" />
        <column name="created_at" type="TIMESTAMP(3) NOT NULL" nullable="true" default="CURRENT_TIMESTAMP" />
        <column name="updated_at" type="TIMESTAMP(3) NOT NULL" nullable="true" default="CURRENT_TIMESTAMP" />
      </columns>
      <constraints>
        <primary-key name="dataset_runs_pkey" columns="id, project_id" />
      </constraints>
      <indexes>
        <index name="dataset_runs_dataset_id_idx" unique="false" method="hash">
          <column name="dataset_id" />
        </index>
        <index name="dataset_runs_created_at_idx" unique="false">
          <column name="created_at" />
        </index>
        <index name="dataset_runs_updated_at_idx" unique="false">
          <column name="updated_at" />
        </index>
        <index name="dataset_runs_dataset_id_project_id_name_key" unique="true">
          <column name="dataset_id" />
          <column name="project_id" />
          <column name="name" />
        </index>
      </indexes>
    </table>
    <table name="dataset_run_items">
      <columns>
        <column name="id" type="TEXT" nullable="false" />
        <column name="project_id" type="TEXT" nullable="false" ref-table="dataset_items" ref-col="project_id" />
        <column name="dataset_run_id" type="TEXT" nullable="false" ref-table="dataset_runs" ref-col="id" />
        <column name="dataset_item_id" type="TEXT" nullable="false" ref-table="dataset_items" ref-col="id" />
        <column name="trace_id" type="TEXT" nullable="false" />
        <column name="observation_id" type="TEXT" nullable="true" />
        <column name="created_at" type="TIMESTAMP(3) NOT NULL" nullable="true" default="CURRENT_TIMESTAMP" />
        <column name="updated_at" type="TIMESTAMP(3) NOT NULL" nullable="true" default="CURRENT_TIMESTAMP" />
      </columns>
      <constraints>
        <primary-key name="dataset_run_items_pkey" columns="id, project_id" />
      </constraints>
      <indexes>
        <index name="dataset_run_items_dataset_run_id_idx" unique="false" method="hash">
          <column name="dataset_run_id" />
        </index>
        <index name="dataset_run_items_dataset_item_id_idx" unique="false" method="hash">
          <column name="dataset_item_id" />
        </index>
        <index name="dataset_run_items_observation_id_idx" unique="false" method="hash">
          <column name="observation_id" />
        </index>
        <index name="dataset_run_items_trace_id_idx" unique="false">
          <column name="trace_id" />
        </index>
        <index name="dataset_run_items_created_at_idx" unique="false">
          <column name="created_at" />
        </index>
        <index name="dataset_run_items_updated_at_idx" unique="false">
          <column name="updated_at" />
        </index>
      </indexes>
    </table>
  </tables>
</database>
